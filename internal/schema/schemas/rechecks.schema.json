{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "复查标记",
  "description": "影响传播（Ripple Analysis）标记的受影响后续场景：wa-cli impact mark 追加写入，复查通过（重新审查或作者确认无影响）后经 wa-cli impact clear 解除；组稿关卡消费 open 标记。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenes"],
  "properties": {
    "schema_version": {"const": 1},
    "scenes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scene", "target", "via", "reason", "marked_at", "status"], "properties": {
      "scene": {"type": "string", "pattern": "\\S", "description": "受影响的场景单元引用"},
      "target": {"type": "string", "pattern": "\\S", "description": "被修改的目标：场景、设定条目、事件或伏笔的引用或 id"},
      "via": {"enum": ["cause-event", "character", "state", "knowledge", "thread"]},
      "reason": {"type": "string", "pattern": "\\S"},
      "marked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
      "status": {"enum": ["open", "cleared"]},
      "cleared_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "解除时间；open 时不得设置（领域校验）"},
      "confirmation": {"type": ["string", "null"], "pattern": "\\S", "description": "作者确认无影响的原话摘要（作者路径解除时非空）"},
      "review_based": {"type": "boolean", "description": "true 表示经重新审查通过解除（review-based 路径）"}
    }}}
  }
}
