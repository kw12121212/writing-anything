{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "卷末检查点",
  "description": "部单元目录中的卷末检查点（Volume Checkpoint）：本部最后一个场景验收后汇总本部新增设定、已确认状态变化、伏笔变化与未处理决策，并确定性抽取收口条目供作者核对；strict 关卡下未经作者确认，下一部的场景不能验收。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "part",
    "scene"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "part": {
      "type": "string",
      "pattern": "\\S",
      "description": "部单元引用"
    },
    "scene": {
      "type": "string",
      "pattern": "\\S",
      "description": "本部子树按单元树先序最后一个场景的引用"
    },
    "canon": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "description": "本部各场景收口新增的设定条目 id（并集，按首次出现）"
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "description": "本部收口提交且当前 status 为 confirmed 的状态变化提议 id"
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "description": "本部场景埋设或回收的伏笔 id"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "description": "生成时尚未处理（open）的决策 id"
    },
    "sampled": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene",
          "kind",
          "id",
          "text"
        ],
        "properties": {
          "scene": {
            "type": "string",
            "pattern": "\\S",
            "description": "提交所在的场景引用"
          },
          "kind": {
            "enum": [
              "state",
              "knowledge"
            ]
          },
          "id": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "台账条目 id"
          },
          "text": {
            "type": "string",
            "pattern": "\\S",
            "description": "状态变化描述或被获知设定条目的 text"
          }
        }
      }
    },
    "confirmed_by_author": {
      "type": "boolean",
      "description": "作者是否已确认本检查点；缺省为 false"
    },
    "confirmation": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S",
      "description": "作者确认原话摘要；confirmed_by_author 为 true 时非空（领域校验报告 volume.incomplete-confirmation）"
    },
    "channel": {
      "enum": [
        "cli",
        "preview",
        null
      ],
      "description": "确认渠道（Confirmation Channel）：cli 或 preview；未确认为 null 或缺省，已确认而缺省时按 cli 解释"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "确认时间（UTC）"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "生成时子树全部场景正文 SHA-256 按先序拼接后的 SHA-256；与当前指纹一致且最后场景未变时重生成不写文件"
    }
  }
}