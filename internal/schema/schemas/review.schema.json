{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "审稿",
  "description": "单元的审稿（Review）：Agent 的 AI 预审（Pre-review），按评分标准（Rubric）逐项的结论与发现项（Finding）；draft_sha256 为审稿所依据的正文。请用 wa-cli review record 与 wa-cli review resolve 修改。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_sha256",
    "rubric",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "draft_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "rubric": {
      "$ref": "#/$defs/verdicts"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "paragraph",
          "message",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "rubric": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "paragraph": {
            "$ref": "#/$defs/paragraph"
          },
          "quote": {
            "type": "string",
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "suggestion": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "waived"
            ]
          },
          "note": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "reaffirms": {
      "type": "array",
      "description": "重申（Reaffirm）记录：小改动后沿用既有结论的一键重申，含变化摘要与本次标记的发现项；按时间追加。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "summary",
          "draft_sha256"
        ],
        "properties": {
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "summary": {
            "type": "string",
            "pattern": "\\S",
            "description": "自上次审稿以来的正文变化摘要；重申必须留痕，防止橡皮图章"
          },
          "draft_sha256": {
            "$ref": "common.schema.json#/$defs/sha256",
            "description": "重申所对应的正文哈希（与顶层的 draft_sha256 同步更新）"
          },
          "resolved": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "waived": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "paragraph": {
      "type": "integer",
      "minimum": 1,
      "description": "段落编号，从 1 开始，与 wa-cli provenance 一致"
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "verdict",
          "evidence"
        ],
        "properties": {
          "item": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidence": {
            "type": "string",
            "pattern": "\\S"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/paragraph"
            },
            "description": "结论依据的段落编号；不针对段落的评分项（如评作者选定的标题）可以为空或省略，写出时规范化为空数组"
          }
        }
      }
    }
  }
}
