{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "规划",
  "description": "单元目录中的规划（Plan）：按规划类写作法的步骤（Planning Step）分步产出，每步记录规划文本、关联的素材、产物链接（Plan Link）与作者确认记录（Confirmation Record）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "method": {"$ref": "common.schema.json#/$defs/id"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "text", "confirmed_by_author"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "title": {"$ref": "common.schema.json#/$defs/text"},
          "text": {"type": "string", "pattern": "\\S"},
          "sources": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
          "links": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "uniqueItems": true},
          "confirmed_by_author": {"type": "boolean"},
          "confirmation": {"type": ["string", "null"], "pattern": "\\S", "description": "作者原话摘要；未确认为 null 或缺省。已确认的步骤缺非空 confirmation 由领域校验报告 plan.incomplete-confirmation"},
          "channel": {"enum": ["cli", "preview", null], "description": "确认渠道（Confirmation Channel）：cli 或 preview；未确认为 null 或缺省，已确认而缺省时按 cli 解释"},
          "confirmed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "确认时间（UTC）；未确认为 null 或缺省。已确认的步骤缺 confirmed_at 同样报告 plan.incomplete-confirmation"}
        }
      }
    }
  }
}
