{
  "name": "dsh-writing-viewer",
  "version": "0.1.0",
  "description": "Read-only DeepSeek Harness (DSH) panel that locates a writing-anything workspace (.writing-anything/) and reports its status. Scaffold panel of the DSH workspace viewer plugin.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown && node scripts/normalize-outputs.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
