{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "大纲",
  "description": "单元的大纲（Outline）：按顺序排列的大纲节，每节声明覆盖的核心观点、使用的素材或不覆盖的理由。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "title": {"type": "string", "pattern": "\\S"},
          "covers": {"$ref": "common.schema.json#/$defs/ids"},
          "uses": {"$ref": "common.schema.json#/$defs/ids"},
          "reason": {"type": "string", "pattern": "\\S"},
          "role": {"$ref": "common.schema.json#/$defs/id", "description": "该节承担的写作法章节或节拍 id"},
          "characters": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "\\S"},
            "description": "轻量场景契约（Scene Contract）：本场景出场的角色"
          },
          "beats": {"$ref": "common.schema.json#/$defs/ids", "description": "轻量场景契约：本场景承担的情节节拍（Story Beat）id，指向同一作品根单元大纲的节"},
          "reveal": {"type": "string", "pattern": "\\S", "description": "轻量场景契约：揭示边界（Reveal Boundary），本场景不能提前透露的信息"},
          "pov": {"type": "string", "pattern": "\\S", "description": "长篇场景契约：视角人物"},
          "location": {"type": "string", "pattern": "\\S", "description": "长篇场景契约：地点"},
          "state_changes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": {"$ref": "common.schema.json#/$defs/id", "description": "必须发生的状态变化 id，节内不重复"},
                "text": {"type": "string", "pattern": "\\S", "description": "必须发生的状态变化描述"}
              }
            },
            "description": "长篇场景契约：必须发生的状态变化，写后收口按 id 对照提交"
          },
          "plants": {"$ref": "common.schema.json#/$defs/ids", "description": "长篇场景契约：本场景要埋设的伏笔（Foreshadowing）id"},
          "recovers": {"$ref": "common.schema.json#/$defs/ids", "description": "长篇场景契约：本场景要回收的伏笔 id"},
          "causes": {"$ref": "common.schema.json#/$defs/ids", "description": "长篇场景契约：起因（Cause），引用前文已发生事件的 id"},
          "events": {"$ref": "common.schema.json#/$defs/ids", "description": "长篇场景契约：预期产生的事件（Event）id，作品内唯一"},
          "targets": {
            "type": "object",
            "propertyNames": {"$ref": "common.schema.json#/$defs/id"},
            "additionalProperties": {"type": "integer"},
            "description": "轻量场景契约：AI 评分指标（Metric）id 到目标锚定分值的映射，供曲线对比目标走势"
          }
        }
      }
    }
  }
}
