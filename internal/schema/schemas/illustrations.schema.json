{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "配图登记",
  "description": "单元的配图登记（Illustration Registry）：每项记录一张配图（Illustration）或封面图（Cover Image）的用途、图片文件、替代文字、内容类型、出处与关联的论断和素材。请用 wa-cli illustration add 写入。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "illustrations"],
  "properties": {
    "schema_version": {"const": 1},
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "file", "format", "sha256", "width", "height", "alt", "content", "origin", "claims", "sources", "added_at"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "role": {"enum": ["body", "cover"], "description": "body 为正文配图，cover 为作品的封面图"},
          "file": {"type": "string", "pattern": "^illustrations/[a-z][a-z0-9]*(-[a-z0-9]+)*\\.(png|jpg)$"},
          "format": {"enum": ["png", "jpeg"]},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "alt": {"type": "string", "maxLength": 200, "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"},
          "title": {"type": ["string", "null"], "maxLength": 200, "pattern": "^[^\\r\\n]*$"},
          "content": {"enum": ["mood", "infographic"], "description": "mood 为氛围图（Mood Image），infographic 为信息图（Infographic）"},
          "origin": {"enum": ["agent", "author"]},
          "tool": {"type": ["string", "null"], "maxLength": 100, "pattern": "^[^\\r\\n]*$"},
          "style": {"type": ["string", "null"], "maxLength": 100, "pattern": "^[^\\r\\n]*$"},
          "claims": {"$ref": "common.schema.json#/$defs/ids"},
          "sources": {"$ref": "common.schema.json#/$defs/ids"},
          "added_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    }
  }
}
