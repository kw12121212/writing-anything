{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作区配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "packs", "gate_level"],
  "properties": {
    "schema_version": {"const": 1},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "default_genre": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"}
    },
    "gate_level": {"enum": ["strict", "standard", "fast"]},
    "rules": {"$ref": "common.schema.json#/$defs/rules"},
    "waivers": {"$ref": "common.schema.json#/$defs/waivers"},
    "context_budget": {"$ref": "common.schema.json#/$defs/budget"},
    "ai_disclosure": {"enum": ["footer", "metadata", "both"], "description": "AI 参与说明（AI-generated Content Label）的放置位置：文末、导出元数据或两者；省略时为 both"},
    "review_surface": {"enum": ["browser", "dsh"], "description": "作者审阅阅读页（Reading View）的位置：browser 为浏览器打开 wa-cli preview --serve 的地址，dsh 为 DSH 插件面板；省略时为 browser"}
  }
}
