{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "审稿",
  "description": "单元的审稿（Review）：Agent 的 AI 预审（Pre-review），按评分标准（Rubric）逐项的结论与发现项（Finding）；draft_sha256 为审稿所依据的正文。请用 wa-cli review record 与 wa-cli review resolve 修改。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_sha256", "rubric", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "draft_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "rubric": {"$ref": "#/$defs/verdicts"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paragraph", "message", "status"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "rubric": {"$ref": "common.schema.json#/$defs/id"},
          "paragraph": {"$ref": "#/$defs/paragraph"},
          "quote": {"type": "string", "pattern": "\\S"},
          "message": {"type": "string", "pattern": "\\S"},
          "suggestion": {"type": "string", "pattern": "\\S"},
          "status": {"enum": ["open", "resolved", "waived"]},
          "note": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  },
  "$defs": {
    "paragraph": {"type": "integer", "minimum": 1, "description": "段落编号，从 1 开始，与 wa-cli provenance 一致"},
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "verdict", "evidence", "paragraphs"],
        "properties": {
          "item": {"$ref": "common.schema.json#/$defs/id"},
          "verdict": {"enum": ["pass", "fail"]},
          "evidence": {"type": "string", "pattern": "\\S"},
          "paragraphs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/paragraph"}}
        }
      }
    }
  }
}
