{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "验收",
  "description": "单元的验收（Acceptance）记录：关卡强度、验收时的正文 SHA-256、是否经作者确认与作者确认原话摘要（确认记录（Confirmation Record））。请用 wa-cli accept 写入。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_level", "draft_sha256", "confirmed_by_author", "accepted_at"],
  "properties": {
    "schema_version": {"const": 1},
    "gate_level": {"enum": ["strict", "standard", "fast"]},
    "draft_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "confirmed_by_author": {"type": "boolean"},
    "confirmation": {"type": "string", "pattern": "\\S"},
    "channel": {"$ref": "common.schema.json#/$defs/channel"},
    "accepted_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "if": {"properties": {"confirmed_by_author": {"const": true}}},
  "then": {"required": ["confirmation"]}
}
